# Copy to .env and fill in from Supabase → Project Settings → API
# Save the file, then restart: npm run dev

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use either key from the dashboard (both work):
# - Legacy "anon" key (starts with eyJ...)
# - New "publishable" key (starts with sb_publishable_...)
VITE_SUPABASE_ANON_KEY=your_key_here

# Server-side (Vercel API routes / cron). NEVER expose in VITE_ variables.
# Service role key from Supabase → Project Settings → API → service_role (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Web Push VAPID public key (base64url) for push notifications
# Generate with: npx web-push generate-vapid-keys
# Required for "Push Notifications" toggle in Account Settings
VITE_VAPID_PUBLIC_KEY=BNS7Iyp9mtLB8gABfcYj66OftLRTUmWyihTDdG7VmtB2xKPw-aetTmilV8s2uWOnKoF6rJw3EBXoGR7qHEmD_JY

VAPID_PRIVATE_KEY=aJTZp_zmg2WZHLcE8J09N0M2Np60nfpVueZnRWHL5ws